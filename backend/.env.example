# Copy to .env (git-ignored) and fill in. Every value has a local-dev default.

# local (one process, in-memory bus) | kafka (one process per service, needs a Kafka broker)
PIPELINE_MODE=local
# memory | postgres
STORAGE=memory
KAFKA_BOOTSTRAP=localhost:9092
# Only for STORAGE=postgres: postgresql://<user>:<password>@<host>:5432/<db>
DATABASE_URL=

# real (default): Open-Meteo + NWS + GOES GLM + the pipeline's trained model
# dummy: offline simulated world (demos, tests)
DATA_SOURCE=real

# Override one feed without changing the rest (leave empty to follow DATA_SOURCE)
WEATHER_SOURCE=
ALERT_SOURCE=
LIGHTNING_SOURCE=
MODEL_KIND=
NWS_USER_AGENT=CrewSafe/0.1 (your-email@example.com)
# Optional paid Open-Meteo key. Without it, stay under ~10,000 location-calls/day
# (defaults: 0.1° grid, weather every 45 min, model inputs every 6 h).
OPEN_METEO_API_KEY=
WEATHER_GRID_DEG=0.1
GLM_BUCKET=noaa-goes19
WEATHER_INTERVAL=
MODEL_INPUTS_INTERVAL=21600
ALERT_INTERVAL=
LIGHTNING_INTERVAL=
BACKFILL_HOURS=8
# Fabricated demo alerts/reports. Defaults on for dummy, off for real.
SEED_DEMO_HISTORY=
# Hour of day the dummy world starts at (empty = real Florida time)
DUMMY_DEMO_HOUR=14

# Path to the repo's pipeline/ (sites + FEMA join + trained classifier)
PIPELINE_DIR=
# Model: pipeline (default in real mode) | dummy | lightgbm
MODEL_PATH=

# Auth: the app doesn't log in yet, so this is off for local development.
AUTH_REQUIRED=false
# At least 32 random bytes, e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`
JWT_SECRET=
DEMO_PASSWORD=

# Push (not wired yet): APNs token auth and SMS fallback
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_KEY_PATH=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
