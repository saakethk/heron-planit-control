# Copy to .env (git-ignored) and fill in. Every value has a local-dev default.

# local (one process, in-memory bus) | kafka (one process per service, needs a Kafka broker)
PIPELINE_MODE=local
# memory | postgres
STORAGE=memory
KAFKA_BOOTSTRAP=localhost:9092
# Only for STORAGE=postgres: postgresql://<user>:<password>@<host>:5432/<db>
DATABASE_URL=

# Data sources: dummy | open-meteo, dummy | nws, dummy | none
WEATHER_SOURCE=dummy
ALERT_SOURCE=dummy
LIGHTNING_SOURCE=dummy
NWS_USER_AGENT=CrewSafe/0.1 (your-email@example.com)
WEATHER_INTERVAL=30
ALERT_INTERVAL=45
LIGHTNING_INTERVAL=15
BACKFILL_HOURS=8
# Hour of day the dummy world starts at (empty = real Florida time)
DUMMY_DEMO_HOUR=14

# Model: dummy | lightgbm (MODEL_PATH is a folder of <hazard>.txt boosters)
MODEL_KIND=dummy
MODEL_PATH=models/hazard_lgbm

# Auth: the app doesn't log in yet, so this is off for local development.
AUTH_REQUIRED=false
# At least 32 random bytes, e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`
JWT_SECRET=
DEMO_PASSWORD=

# Push (not wired yet): APNs token auth and SMS fallback
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_KEY_PATH=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
